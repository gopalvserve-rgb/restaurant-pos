{
  "manifest_version": 3,
  "name": "Restaurant POS Sync (v8.1 \u2014 full order detail)",
  "version": "8.1.0",
  "description": "Sync brands, outlets, menu, reviews and FULL live order detail (customer, items, price, status) from Swiggy/Zomato into Restaurant POS",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.zomato.com/*",
    "https://api.zomato.com/*",
    "https://partner.swiggy.com/*",
    "https://rms.swiggy.com/*",
    "https://restaurant-pos-app-production.up.railway.app/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Restaurant POS Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}