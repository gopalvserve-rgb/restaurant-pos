{
  "manifest_version": 3,
  "name": "Restaurant POS Sync (v7)",
  "version": "7.0.0",
  "description": "Sync Swiggy/Zomato outlets, menu, inventory & orders into Restaurant POS CRM",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.zomato.com/*",
    "https://api.zomato.com/*",
    "https://partner.swiggy.com/*",
    "https://restaurant-pos-production-7d9d.up.railway.app/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Restaurant POS Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pos-sync-v7@restaurant-pos.local",
      "strict_min_version": "109.0"
    }
  }
}